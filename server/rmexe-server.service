[Unit]
Description=Rockman EXE Mobile Recomp Online & Real-Time PvP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rmexe
Group=rmexe
WorkingDirectory=/opt/rmexe-server
ExecStart=/opt/rmexe-server/rmexe_server --bind 0.0.0.0 --port 8765 --data-dir /var/lib/rmexe-server
Restart=always
RestartSec=3
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rmexe-server

[Install]
WantedBy=multi-user.target
